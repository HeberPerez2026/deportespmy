rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidBooking(data) {
      return data.bookingCode is string && data.bookingCode.size() <= 32
        && data.courtId is string && data.courtId.size() <= 64
        && data.sport is string && data.sport.size() <= 32
        && data.date is string && data.date.size() <= 16
        && data.startTime is string && data.startTime.size() <= 10
        && data.clientName is string && data.clientName.size() <= 128
        && data.totalAmount is number
        && data.status is string && (
          data.status == 'confirmed' ||
          data.status == 'cancelled' ||
          data.status == 'pending_payment' ||
          data.status == 'awaiting_approval' ||
          data.status == 'completed'
        );
    }

    function isValidReview(data) {
      return data.courtId is string && data.courtId.size() <= 64
        && data.userName is string && data.userName.size() <= 128
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() <= 1000
        && data.date is string && data.date.size() <= 16;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if isValidId(bookingId) && isValidBooking(incoming());
      allow update: if isValidId(bookingId) && isValidBooking(incoming());
      allow delete: if isValidId(bookingId);
    }

    // Reviews collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidId(reviewId) && isValidReview(incoming());
      allow update: if isValidId(reviewId);
      allow delete: if isValidId(reviewId);
    }

    // Courts collection
    match /courts/{courtId} {
      allow read: if true;
      allow write: if isValidId(courtId);
      allow delete: if isValidId(courtId);
    }

    // Business profile settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    // Admin users collection
    match /admins/{adminId} {
      allow read: if true;
      allow write: if isValidId(adminId);
      allow delete: if isValidId(adminId);
    }

    // Connection check
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
