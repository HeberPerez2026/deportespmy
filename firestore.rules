rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidBooking(data) {
      return data.bookingCode is string && data.bookingCode.size() <= 32
        && data.courtId is string && data.courtId.size() <= 64
        && data.sport is string && data.sport.size() <= 32
        && data.date is string && data.date.size() <= 16
        && data.startTime is string && data.startTime.size() <= 10
        && data.clientName is string && data.clientName.size() <= 128
        && data.totalAmount is number && data.totalAmount >= 0
        && (!('amountPaid' in data) || (data.amountPaid is number && data.amountPaid >= 0))
        && (!('balanceDue' in data) || (data.balanceDue is number && data.balanceDue >= 0))
        && (!('refundAmount' in data) || (data.refundAmount is number && data.refundAmount >= 0))
        && (!('pushDeviceId' in data) || (data.pushDeviceId is string && data.pushDeviceId.size() <= 128))
        && data.status is string && (
          data.status == 'confirmed' ||
          data.status == 'cancelled' ||
          data.status == 'pending_payment' ||
          data.status == 'awaiting_approval' ||
          data.status == 'completed'
        );
    }

    function isValidReview(data) {
      return data.courtId is string && data.courtId.size() <= 64
        && data.userName is string && data.userName.size() <= 128
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() <= 1000
        && data.date is string && data.date.size() <= 16
        && (!('scores' in data) || (
          data.scores is map
          && data.scores.surface is number && data.scores.surface >= 1 && data.scores.surface <= 5
          && data.scores.lighting is number && data.scores.lighting >= 1 && data.scores.lighting <= 5
          && data.scores.facilities is number && data.scores.facilities >= 1 && data.scores.facilities <= 5
          && data.scores['service'] is number && data.scores['service'] >= 1 && data.scores['service'] <= 5
        ))
        && (!('photos' in data) || (
          data.photos is list
          && data.photos.size() <= 3
          && (data.photos.size() == 0 || (data.photos[0] is string && data.photos[0].size() <= 350000))
        ));
    }

    function isValidCourt(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 128
        && data.sport is string && data.sport.size() <= 32
        && data.hourlyRateDay is number && data.hourlyRateDay >= 0
        && data.hourlyRateNight is number && data.hourlyRateNight >= 0
        && (!('hora_inicio' in data) || (data.hora_inicio is string && data.hora_inicio.size() <= 10))
        && (!('hora_fin' in data) || (data.hora_fin is string && data.hora_fin.size() <= 10))
        && (!('openHour' in data) || (data.openHour is number && data.openHour >= 0 && data.openHour <= 26))
        && (!('closeHour' in data) || (data.closeHour is number && data.closeHour >= 0 && data.closeHour <= 26))
        && (!('nightStartHour' in data) || (data.nightStartHour is number && data.nightStartHour >= 0 && data.nightStartHour <= 25))
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 350000))
        && (!('images' in data) || (
          data.images is list
          && data.images.size() <= 4
          && (data.images.size() == 0 || (data.images[0] is string && data.images[0].size() <= 350000))
        ));
    }

    function isValidPushSubscription(data) {
      return data.deviceId is string && data.deviceId.size() >= 1 && data.deviceId.size() <= 128
        && data.endpoint is string && data.endpoint.size() <= 1000
        && data.enabled is bool
        && (!('p256dh' in data) || (data.p256dh is string && data.p256dh.size() <= 512))
        && (!('auth' in data) || (data.auth is string && data.auth.size() <= 256))
        && (!('clientPhone' in data) || (data.clientPhone is string && data.clientPhone.size() <= 32))
        && (!('clientName' in data) || (data.clientName is string && data.clientName.size() <= 128))
        && (!('bookingCodes' in data) || (
          data.bookingCodes is list
          && data.bookingCodes.size() <= 50
          && (data.bookingCodes.size() == 0 || (data.bookingCodes[0] is string && data.bookingCodes[0].size() <= 32))
        ));
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if isValidId(bookingId) && isValidBooking(incoming());
      allow update: if isValidId(bookingId) && isValidBooking(incoming());
      allow delete: if isValidId(bookingId);
    }

    // Reviews collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidId(reviewId) && isValidReview(incoming());
      allow update: if isValidId(reviewId);
      allow delete: if isValidId(reviewId);
    }

    // Courts collection
    match /courts/{courtId} {
      allow read: if true;
      allow create: if isValidId(courtId) && isValidCourt(incoming());
      allow update: if isValidId(courtId) && isValidCourt(incoming());
      allow delete: if isValidId(courtId);
    }

    // Business profile settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    // Admin users collection
    match /admins/{adminId} {
      allow read: if true;
      allow write: if isValidId(adminId);
      allow delete: if isValidId(adminId);
    }

    // Web Push Subscriptions collection
    match /pushSubscriptions/{subscriptionId} {
      allow read: if true;
      allow create, update: if isValidId(subscriptionId) && isValidPushSubscription(incoming());
      allow delete: if isValidId(subscriptionId);
    }

    // Connection check
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
