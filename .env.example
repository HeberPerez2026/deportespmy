# ==========================================
# CONFIGURACIÓN DEPORTESPMY & MERCADO PAGO OAUTH
# ==========================================

# 1. Credenciales de Plataforma Mercado Pago OAuth (Marketplace / Connect):
# Creá tu aplicación en https://www.mercadopago.com.ar/developers/panel/app
# Configurá las Redirect URIs con tu URL + /api/mercadopago/oauth/callback
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""

# 2. Credencial Global Opcional (Fallback si no se usa OAuth por complejo):
MP_ACCESS_TOKEN=""
MP_PUBLIC_KEY=""

# 3. Configuración de Red del Servidor:
PORT=3000
APP_URL="http://localhost:3000"
# Opcional para despliegues estáticos (ej. GitHub Pages / dominio propio) que apuntan al backend en Cloud Run:
VITE_API_BASE_URL=""

# 4. Opcional (Asistente de IA Gemini):
GEMINI_API_KEY=""

# 5. Opcional (Notificaciones Web Push VAPID - si se dejan vacías se autogeneran y guardan en Firestore):
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:soporte@deportespmy.com.ar"

# 6. WhatsApp Cloud API (Meta Graph API) — Confirmaciones de reservas y avisos a jugadores:
# Configurá estos valores desde Meta for Developers (WhatsApp > API Setup / Token de usuario del sistema)
WHATSAPP_CLOUD_ACCESS_TOKEN=""
WHATSAPP_CLOUD_PHONE_NUMBER_ID=""
WHATSAPP_CLOUD_API_VERSION="v21.0"
# Opcional: nombres de plantillas aprobadas en Meta (si se dejan vacías se envía mensaje de texto directo):
WHATSAPP_TEMPLATE_BOOKING_CONFIRMED=""
WHATSAPP_TEMPLATE_BOOKING_APPROVED=""
WHATSAPP_TEMPLATE_BOOKING_CANCELLED=""
WHATSAPP_TEMPLATE_MISSING_PLAYERS=""
WHATSAPP_TEMPLATE_TOURNAMENT_CREATED=""
WHATSAPP_TEMPLATE_LANG="es_AR"
