# ==========================================
# CONFIGURACIÓN DEPORTESPMY & MERCADO PAGO OAUTH
# ==========================================

# 1. Credenciales de Plataforma Mercado Pago OAuth (Marketplace / Connect):
# Creá tu aplicación en https://www.mercadopago.com.ar/developers/panel/app
# Configurá las Redirect URIs con tu URL + /api/mercadopago/oauth/callback
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""

# 2. Credencial Global Opcional (Fallback si no se usa OAuth por complejo):
MP_ACCESS_TOKEN=""
MP_PUBLIC_KEY=""

# 3. Configuración de Red del Servidor:
PORT=3000
APP_URL="http://localhost:3000"
# Opcional para despliegues estáticos (ej. GitHub Pages / dominio propio) que apuntan al backend en Cloud Run:
VITE_API_BASE_URL=""

# 4. Opcional (Asistente de IA Gemini):
GEMINI_API_KEY=""
