{
  "entities": {
    "Booking": {
      "title": "Booking",
      "description": "Reservation for a sports court time slot in DeportesPMY",
      "type": "object",
      "properties": {
        "bookingCode": { "type": "string", "maxLength": 32 },
        "courtId": { "type": "string", "maxLength": 64 },
        "courtName": { "type": "string", "maxLength": 128 },
        "establishment": { "type": "string", "maxLength": 128 },
        "sport": { "type": "string", "maxLength": 32 },
        "date": { "type": "string", "maxLength": 16 },
        "startTime": { "type": "string", "maxLength": 10 },
        "endTime": { "type": "string", "maxLength": 10 },
        "durationMinutes": { "type": "number" },
        "clientName": { "type": "string", "maxLength": 128 },
        "clientPhone": { "type": "string", "maxLength": 32 },
        "clientEmail": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 500 },
        "totalAmount": { "type": "number" },
        "amountPaid": { "type": "number" },
        "balanceDue": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 32 },
        "paymentStatus": { "type": "string", "maxLength": 32 },
        "isDepositOnly": { "type": "boolean" },
        "paymentReference": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "whatsappSent": { "type": "boolean" },
        "whatsappSentAt": { "type": "string", "maxLength": 64 },
        "adminId": { "type": "string", "maxLength": 64 },
        "receiptUrl": { "type": "string", "maxLength": 500000 },
        "refundAmount": { "type": "number" },
        "refundedAt": { "type": "string", "maxLength": 64 },
        "refundReference": { "type": "string", "maxLength": 64 },
        "pushDeviceId": { "type": "string", "maxLength": 128 },
        "lookingForPlayers": { "type": "boolean" },
        "neededPlayers": { "type": "number" },
        "lookingForPlayersMessage": { "type": "string", "maxLength": 300 },
        "lookingForPlayersUpdatedAt": { "type": "string", "maxLength": 64 },
        "joinedPlayers": { "type": "array", "description": "List of players who joined this match" },
        "totalPlayers": { "type": "number" },
        "perPlayerAmount": { "type": "number" },
        "recurringGroupId": { "type": "string", "maxLength": 80 },
        "recurringIndex": { "type": "number" },
        "recurringTotal": { "type": "number" },
        "rescheduledFrom": { "type": "object", "description": "Previous slot before rescheduling" },
        "rescheduledAt": { "type": "string", "maxLength": 64 },
        "reminderSentAt": { "type": "string", "maxLength": 64 }
      },
      "required": [
        "bookingCode",
        "courtId",
        "sport",
        "date",
        "startTime",
        "clientName",
        "totalAmount",
        "status"
      ]
    },
    "Review": {
      "title": "Review",
      "description": "Customer feedback and ratings for sports facilities",
      "type": "object",
      "properties": {
        "courtId": { "type": "string", "maxLength": 64 },
        "courtName": { "type": "string", "maxLength": 128 },
        "sport": { "type": "string", "maxLength": 32 },
        "userName": { "type": "string", "maxLength": 128 },
        "userPhone": { "type": "string", "maxLength": 32 },
        "rating": { "type": "number" },
        "scores": { "type": "object", "description": "Category scores (surface, lighting, facilities, service)" },
        "comment": { "type": "string", "maxLength": 1000 },
        "date": { "type": "string", "maxLength": 16 },
        "photos": { "type": "array", "description": "Optional photos attached to the review" },
        "adminId": { "type": "string", "maxLength": 64 }
      },
      "required": ["courtId", "userName", "rating", "comment", "date"]
    },
    "Court": {
      "title": "Court",
      "description": "Sports court configuration and pricing",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 128 },
        "establishment": { "type": "string", "maxLength": 128 },
        "sport": { "type": "string", "maxLength": 32 },
        "surface": { "type": "string", "maxLength": 64 },
        "isIndoor": { "type": "boolean" },
        "hasLighting": { "type": "boolean" },
        "hourlyRateDay": { "type": "number" },
        "hourlyRateNight": { "type": "number" },
        "hora_inicio": { "type": "string", "maxLength": 10 },
        "hora_fin": { "type": "string", "maxLength": 10 },
        "openHour": { "type": "number" },
        "closeHour": { "type": "number" },
        "nightStartHour": { "type": "number" },
        "depositRequired": { "type": "number" },
        "imageUrl": { "type": "string", "maxLength": 350000 },
        "images": { "type": "array", "description": "Gallery of attached court photos" },
        "description": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "maxLength": 32 },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "adminId": { "type": "string", "maxLength": 64 }
      },
      "required": ["name", "sport", "hourlyRateDay", "hourlyRateNight"]
    },
    "BusinessProfile": {
      "title": "BusinessProfile",
      "description": "Administrator business contact, CBU/Alias, Mercado Pago OAuth, social feeds and address details",
      "type": "object",
      "properties": {
        "ownerName": { "type": "string", "maxLength": 128 },
        "complexName": { "type": "string", "maxLength": 128 },
        "cbu": { "type": "string", "maxLength": 32 },
        "alias": { "type": "string", "maxLength": 64 },
        "accountHolder": { "type": "string", "maxLength": 128 },
        "whatsappNumber": { "type": "string", "maxLength": 32 },
        "address": { "type": "string", "maxLength": 256 },
        "email": { "type": "string", "maxLength": 128 },
        "welcomeNotes": { "type": "string", "maxLength": 500 },
        "mpLink": { "type": "string", "maxLength": 256 },
        "whatsappTemplate": { "type": "string", "maxLength": 2000 },
        "mpOAuthConnected": { "type": "boolean" },
        "mpUserId": { "type": "string", "maxLength": 64 },
        "mpAccountEmail": { "type": "string", "maxLength": 128 },
        "mpAccountNickname": { "type": "string", "maxLength": 128 },
        "mpAccessToken": { "type": "string", "maxLength": 512 },
        "mpRefreshToken": { "type": "string", "maxLength": 512 },
        "mpPublicKey": { "type": "string", "maxLength": 256 },
        "mpTokenExpiresAt": { "type": "string", "maxLength": 64 },
        "mpConnectedAt": { "type": "string", "maxLength": 64 },
        "mpPaused": { "type": "boolean" },
        "transferPaused": { "type": "boolean" },
        "instagramUrl": { "type": "string", "maxLength": 256 },
        "facebookUrl": { "type": "string", "maxLength": 256 },
        "tiktokUrl": { "type": "string", "maxLength": 256 },
        "youtubeUrl": { "type": "string", "maxLength": 256 },
        "socialFeedUrl": { "type": "string", "maxLength": 500 },
        "mapsUrl": { "type": "string", "maxLength": 500 },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "cancellationWindowHours": { "type": "number" },
        "reminderHoursBefore": { "type": "number" }
      }
    },
    "DeveloperContact": {
      "title": "DeveloperContact",
      "description": "Developer contact details shown in the platform footer",
      "type": "object",
      "properties": {
        "developerName": { "type": "string", "maxLength": 128 },
        "roleTitle": { "type": "string", "maxLength": 128 },
        "whatsappNumber": { "type": "string", "maxLength": 32 },
        "email": { "type": "string", "maxLength": 128 },
        "websiteUrl": { "type": "string", "maxLength": 256 }
      }
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Administrator or SuperAdmin user account",
      "type": "object",
      "properties": {
        "username": { "type": "string", "maxLength": 64 },
        "fullName": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 32 },
        "password": { "type": "string", "maxLength": 64 },
        "role": { "type": "string", "maxLength": 32 },
        "assignedComplex": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "isActive": { "type": "boolean" }
      },
      "required": ["username", "password", "role"]
    },
    "SiteContent": {
      "title": "SiteContent",
      "description": "SuperAdmin-editable texts displayed across player views",
      "type": "object",
      "properties": {
        "navTurnosLabel": { "type": "string", "maxLength": 64 },
        "navComplejosLabel": { "type": "string", "maxLength": 64 },
        "navOpinionesLabel": { "type": "string", "maxLength": 64 },
        "heroLocationEyebrow": { "type": "string", "maxLength": 200 },
        "heroTitle": { "type": "string", "maxLength": 200 },
        "heroSubtitle": { "type": "string", "maxLength": 500 },
        "heroKpiCourtsLabel": { "type": "string", "maxLength": 64 },
        "heroKpiComplexesLabel": { "type": "string", "maxLength": 64 },
        "heroBadgeMpLabel": { "type": "string", "maxLength": 100 },
        "heroBadgeWaLabel": { "type": "string", "maxLength": 100 },
        "heroSearchPlaceholder": { "type": "string", "maxLength": 200 },
        "catalogEyebrow": { "type": "string", "maxLength": 120 },
        "catalogTitlePrefix": { "type": "string", "maxLength": 120 },
        "catalogSubtitle": { "type": "string", "maxLength": 400 },
        "filterTags": { "type": "array", "description": "Customizable sport filter tags and surfaces managed by SuperAdmin" }
      }
    },
    "PushSubscription": {
      "title": "PushSubscription",
      "description": "Web Push Service Worker subscription linked to player device and booking codes",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string", "maxLength": 128 },
        "endpoint": { "type": "string", "maxLength": 1000 },
        "p256dh": { "type": "string", "maxLength": 512 },
        "auth": { "type": "string", "maxLength": 256 },
        "bookingCodes": { "type": "array", "description": "Booking codes tracked by this device" },
        "clientPhone": { "type": "string", "maxLength": 32 },
        "clientName": { "type": "string", "maxLength": 128 },
        "enabled": { "type": "boolean" },
        "userAgent": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["deviceId", "endpoint", "enabled"]
    },
    "AvailablePlayer": {
      "title": "AvailablePlayer",
      "description": "Player registered as available to play for the current day until 23:59",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 32 },
        "preferredSports": { "type": "array", "description": "List of preferred sports IDs" },
        "timePreference": { "type": "string", "maxLength": 64 },
        "notes": { "type": "string", "maxLength": 300 },
        "date": { "type": "string", "maxLength": 16 },
        "expiresAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "pushDeviceId": { "type": "string", "maxLength": 128 }
      },
      "required": ["name", "phone", "date", "expiresAt"]
    },
    "Tournament": {
      "title": "Tournament",
      "description": "Sports tournament, lightning cup or private event optionally blocking courts",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 140 },
        "sport": { "type": "string", "maxLength": 32 },
        "establishment": { "type": "string", "maxLength": 128 },
        "adminId": { "type": "string", "maxLength": 64 },
        "date": { "type": "string", "maxLength": 16 },
        "endDate": { "type": "string", "maxLength": 16 },
        "startTime": { "type": "string", "maxLength": 10 },
        "endTime": { "type": "string", "maxLength": 10 },
        "courtIds": { "type": "array", "description": "Court IDs assigned/blocked for this event" },
        "blockCourts": { "type": "boolean" },
        "maxTeams": { "type": "number" },
        "entryFee": { "type": "number" },
        "prizeDescription": { "type": "string", "maxLength": 300 },
        "description": { "type": "string", "maxLength": 1000 },
        "format": { "type": "string", "maxLength": 80 },
        "status": { "type": "string", "maxLength": 32 },
        "teams": { "type": "array", "description": "Registered teams" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["title", "sport", "date", "startTime", "endTime", "maxTeams", "entryFee", "status"]
    }
  },
  "firestore": {
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Sport court bookings and reservations"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Customer reviews and feedback"
    },
    "/courts/{courtId}": {
      "schema": "Court",
      "description": "Sports court details, surfaces and hourly fees"
    },
    "/settings/businessProfile": {
      "schema": "BusinessProfile",
      "description": "Business payment coordinates, contact and WhatsApp numbers"
    },
    "/settings/developerContact": {
      "schema": "DeveloperContact",
      "description": "Developer contact and support coordinates"
    },
    "/settings/siteContent": {
      "schema": "SiteContent",
      "description": "Editable player-view copy managed by SuperAdmin"
    },
    "/admins/{adminId}": {
      "schema": "AdminUser",
      "description": "System administrators and superadmin credentials"
    },
    "/pushSubscriptions/{subscriptionId}": {
      "schema": "PushSubscription",
      "description": "Player Web Push subscriptions for real-time booking status notifications"
    },
    "/availablePlayers/{playerId}": {
      "schema": "AvailablePlayer",
      "description": "Daily expiring list of players available to join matches today"
    },
    "/tournaments/{tournamentId}": {
      "schema": "Tournament",
      "description": "Sports tournaments, lightning cups and events"
    }
  }
}
