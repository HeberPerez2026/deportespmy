{
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "firebase-applet-config.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__vercel_api_path=$1"
    },
    {
      "source": "/((?!api/|sw\\.js|manifest\\.webmanifest|icon\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
